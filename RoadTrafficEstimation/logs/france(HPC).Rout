> if (!exists("PROJECT_ROOT")) {
+   # Option 1: use the path given in the script .sh as environment variable
+   PROJECT_ROOT <- Sys.getenv("PROJECT_ROOT")
+   if (PROJECT_ROOT == "") {
+     # Option 2: fallback -> current repository
+     PROJECT_ROOT <- getwd()
+   }
+ }
> setwd(PROJECT_ROOT)
